# Copy to app/.env (kept out of git) and fill in. Read by app.config.js at build time.
# For EAS cloud builds, set these as EAS environment variables or in eas.json "env" instead.

# Your server's address, pre-filled on the sign-in screen. Leave empty to type it in the app.
DRIVESTREAM_SERVER=https://stream.example.com

# Your own Android application id (reverse domain you control). Must be unique per app.
ANDROID_PACKAGE=com.example.drivestream

# Name under the app icon.
APP_NAME=DriveStream

# Only for EAS cloud builds (npx eas-cli init prints the project id).
EAS_PROJECT_ID=
EAS_OWNER=
