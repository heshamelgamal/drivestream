{
  "name": "drivestream",
  "version": "1.0.0",
  "description": "Personal Netflix-style streaming server for your own media in Google Drive or a local folder",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "build:tv": "node tools/build-tv.mjs",
    "build:tizen": "node tools/build-tizen.mjs",
    "check": "node tools/check-credit.mjs && node tools/check-strings.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "qrcode": "1.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "author": "Hesham Elgamal"
}
