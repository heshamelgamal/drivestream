# DriveStream server settings. Copy to .env and fill in. Settings marked REQUIRED
# must be set; everything else is optional. See README.md for the full walkthrough.

# ---------- where your media lives ----------

# "drive" = Google Drive folders (read with a service account)
# "local" = a folder on this server's disk
STORAGE=drive

# Google Drive: path to the service-account key you downloaded from Google Cloud.
# REQUIRED with STORAGE=drive. Keep this file private.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Local folder: REQUIRED with STORAGE=local. Each sub-folder becomes a category
# unless you list CATEGORIES below. In Docker this is the path inside the container (/media).
# LOCAL_MEDIA_DIR=/srv/media

# Your library: Name|type|folder, separated by commas.
#   type   = movie (only films), tv (only series), auto (detect per folder: good for Animation)
#   folder = Drive: a folder link or ID, shared with the service account's email as "Viewer".
#            Local: a sub-folder of LOCAL_MEDIA_DIR, e.g. Movies or Kids/Cartoons
# REQUIRED with STORAGE=drive. Optional with STORAGE=local: then every sub-folder is used,
# and a name containing "TV", "Series" or "Shows" becomes tv, "Movies"/"Films" movie, others auto.
CATEGORIES=Movies|movie|PASTE_FOLDER_LINK, TV Series|tv|PASTE_FOLDER_LINK, Animation|auto|PASTE_FOLDER_LINK

# ---------- titles, posters, plots ----------

# Free key from https://www.themoviedb.org/settings/api (the "API Key" or the "Read Access Token").
# Leave empty to run without posters, plots and ratings.
TMDB_API_KEY=
# Language for titles and plots, e.g. en-US, ar-SA, fr-FR
TMDB_LANGUAGE=en-US

# ---------- server ----------

# Port the server listens on.
PORT=8080
# 0.0.0.0 = reachable on your network. Use 127.0.0.1 behind a reverse proxy (nginx, Caddy).
HOST=0.0.0.0
# The address viewers use, without a trailing slash, e.g. https://stream.example.com
# Set it behind a reverse proxy: cast links, sign-in QR codes and the Google upload
# callback are built from it.
PUBLIC_URL=
# Where the library index, profiles, watch progress and keys are stored (default ./data).
# DATA_DIR=./data

# ---------- sign-in ----------

# The first admin profile is created on first start, with this username (default "admin")
# and APP_PASSWORD as its password (or a random one printed in the server log if empty).
# Add more profiles on the website: profile menu → Manage profiles.
ADMIN_USERNAME=admin
APP_PASSWORD=

# ---------- library scanning ----------

# How often to re-check your folders for new files (minutes). "Refresh library" works too.
RESCAN_MINUTES=30

# ---------- ffmpeg (resolution switching, conversion, intro/credits detection) ----------

# Only needed if ffmpeg/ffprobe aren't on your PATH:
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# How many conversions may run at once (default: half the CPU cores, at least 1).
# Conversions always run at the lowest CPU priority so other services stay fast.
# MAX_TRANSCODES=1
